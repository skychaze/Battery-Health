{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["scripts/*.ts", "src/main/index.ts", "src/preload/index.ts", "src/renderer/main.tsx"],
  "ignoreDependencies": ["playwright-core", "react", "react-dom", "@fontsource/source-sans-3"],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["**/*.test.*", "**/*.spec.*"]
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
